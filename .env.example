# Copie para .env na raiz do projeto (NUNCA commite o arquivo .env)
# Chave AI Studio (formato AIza...): https://aistudio.google.com/apikey
# Cobrança deve estar no MESMO projeto Google Cloud da chave (não basta crédito no Agent Platform).
# Tier gratuito: ~15–20 req/dia em modelos preview; prefira gemini-2.0-flash ou use Catálogo SQL sem IA.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SECRET_KEY=altere-em-producao

# ODA File Converter — conversão planta.dxf → planta.dwg (Windows)
# Download: https://www.opendesign.com/guestfiles/oda_file_converter
# ODA_FILE_CONVERTER=C:\Program Files\ODA\ODAFileConverter\ODAFileConverter.exe
