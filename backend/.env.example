# Chave da API Gemini (https://aistudio.google.com/apikey)
# Copie para .env na RAIZ do projeto (recomendado) ou backend/.env — NUNCA commite
# Usada para enriquecer specs de módulos/inversores e analisar TXT quando Ollama não está disponível
GEMINI_API_KEY=

# Modelo Gemini (opcional)
GEMINI_MODEL=gemini-2.0-flash

# Ollama local (opcional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# Flask
SECRET_KEY=altere-em-producao

# Autenticação (master — senha NUNCA em texto plano no repositório)
# Gere o hash: cd backend && python bootstrap_master_hash.py
MASTER_USERNAME=pieng
MASTER_PASSWORD_HASH=

# Confirmação de dispositivo novo (login master em outro computador)
MASTER_VERIFY_EMAIL=seu-email@example.com
APP_BASE_URL=http://localhost:5173
DEVICE_VERIFY_MINUTES=20
# Verificação de dispositivo novo (e-mail) — desligado por padrão; login só usuário/senha
AUTH_DEVICE_VERIFY=0
# AUTH_DEV_SHOW_CODE=0  # desliga exibição do código na tela quando SMTP estiver vazio (localhost)

# SMTP Gmail — use "Senha de app" (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=
SMTP_FROM=seu-email@gmail.com

# Pasta de saída — Google Drive (dados LGPD; NUNCA commitar)
# Exemplo Windows (Google Drive for Desktop):
# CLIENT_OUTPUT_DIR=I:/Meu Drive/Pieng Soluções Energéticas/pieng/2. Clientes Aprovados/80 a 100
# Se vazio ou indisponível, usa saida/web_generated/ dentro do projeto.
CLIENT_OUTPUT_DIR=

# Figura de localização no memorial (mapa + pin)
# FIGURA_MAP_TILE=osmde   # osmde (padrão) | osm | esri | voyager (voyager exige CARTO_API_KEY)
# FIGURA_MAP_ZOOM=auto     # padrão: 18 urbano denso, 16 rural ou OSM vazio no entorno
# FIGURA_MAP_ZOOM=18       # força zoom fixo (16–18)
# CARTO_API_KEY=          # só se FIGURA_MAP_TILE=voyager

# Procurador e responsável técnico (sobrescrevem config_padrao.local.json se preenchidos)
# Alternativa recomendada: backend/config_padrao.local.json (gitignored)
# PROCURADOR_NOME=
# PROCURADOR_CPF=
# PROCURADOR_RG=
# PROCURADOR_ORGAO_RG=DGPC-GO
# PROCURADOR_UF_RG=GO
# PROCURADOR_REGISTRO=
# PROCURADOR_TITULO=TECNICO EM ELETROTÉCNICA
# PROCURADOR_ENDERECO=
# PROCURADOR_BAIRRO=
# PROCURADOR_CIDADE=
# PROCURADOR_UF=GO
# PROCURADOR_CEP=
# PROCURADOR_TELEFONE=
# PROCURADOR_EMAIL=
# TECNICO_NOME=
# TECNICO_TITULO=TECNICO EM ELETROTÉCNICA
